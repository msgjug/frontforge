enums {
    PreviewMsgType {
        Other 0;
        Refresh 1;
        Select 2;
        Prefab 3;
        Page 3;
    };
};

classes {
    # 编辑器配置
    EditorConfig {
        # 历史项目记录
        project_configs "([ProjectConfig])";
        project_paths "([str])";

        # 窗口状态
        win_main "(bool)true";
        win_main_w "(int)250";
        win_main_h "(int)550";

        win_code "(bool)false";
        win_code_w "(int)700";
        win_code_h "(int)550";

        win_designer "(bool)false";
        win_designer_w "(int)700";
        win_designer_h "(int)550";

        # 编辑器配置
        wrap_mode "(bool)false";
        theme "(str)chaos";
        font_size "(int)12";
        
        # 新建项目的路径记忆
        project_dir "(str)";
    };

    ProjectCompileConfig {
        # 对应项目的Macro 中的 {{DOMAIN}} 项目请求的服务器域名
        server_domain "(str)";
        # 对应项目的Macro 中的 {{DOMAIN}} 项目请求的服务器PATH
        server_path "(str)";

        # todo: apis

    };
    #  
    ProjectConfig { 
        app_name "(str)";
        app_version "(str)";
        path "(str)";
        entrance_prefab_name "(str)";
        prefabs_list "([PrefabConfig])";
        create_date "(int)0";
        edit_date "(int)0";

        compile_dev "(ProjectCompileConfig)";
        compile_res "(ProjectCompileConfig)";
    };
    
    # 
    PrefabConfig {
        name "(str)";
        desc "(str)"; # 说明
        group "(str)";
        # 继承
        extend "(str)AppNode"; 
        is_persist "(bool)false"; # 是否在Main加载（与Scene同级）
        path "(str)"; # 独立path,如果为空，则用 src/prefabs/
    };

    #
    IPCResponse {
        ret "(int)0";
        msg "(str)";
    };


    # =================port msg 
    # 发送LOG
    Log {
        str "(str)";
    };
    
    # 窗口变化
    WindowChange {
        open "(str)";
        close "(str)";
    };
    # 窗口名字（新创建窗口时，IPCS给窗口发送 窗口名
    YourWindowName {
        name "(str)";
    };

    # 打开项目
    OpenProject {
        project_conf "(ProjectConfig)";  
    };

    # 关闭项目
    CloseProject {
        project_conf "(ProjectConfig)";  
    };
    
    # 选择Prefab
    SelectPrefab {
        # 是否有选择文件
        valid "(bool)false";
        prefab_conf "(PrefabConfig)";
        ts_str "(str)";
        dom_str "(str)";
    };

    # 保存Prefab
    SavePrefab {
        prefab_conf "(PrefabConfig)";
        ts_str "(str)";
        dom_str "(str)";
        # 静默保存，界面没有通知
        silent "(bool)false"; 
    };
    # 删除Prefab
    DeletePrefab {
        prefab_conf "(PrefabConfig)";
    };

    # 打开文件
    OpenFile {
        path "(str)";
        str "(str)";
        # ACE编辑器的MODE
        mode "(str)"; 
    };
    # 保存文件
    SaveFile {
        path "(str)";
        str "(str)";
        silent "(bool)false";
    };

    # 设置开始Prefab
    FlagPrefab {
        prefab_conf "(PrefabConfig)";
    };

    # 设置常驻Prefab
    PersistPrefab {
        prefab_conf "(PrefabConfig)";
    };

    # 编辑器配置改变
    EditorConfigChange {
        editor_conf "(EditorConfig)";
    };


    # preview 消息
    PreviewMsg {
        type "(PreviewMsgType)Other";
        args "([str])";
    }
};